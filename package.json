{
  "name": "sui-css",
  "version": "2.0.0",
  "scripts": {
    "build:css": "lightningcss --minify --bundle --targets \">= 0.25%\" src/sui.css -o dist/sui.min.css",
    "build:js": "esbuild src/sui.js --minify --bundle --outfile=dist/sui.min.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lightningcss-cli": "^1.28.2",
    "terser": "^5.51.2"
  },
  "allowScripts": {
    "lightningcss-cli@1.33.0": true,
    "esbuild@0.28.2": true
  }
}
